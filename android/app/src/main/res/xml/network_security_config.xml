<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- اجازه اتصال به سرورهای داخلی بدون SSL (در صورت نیاز) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
